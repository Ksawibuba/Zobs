  <remote name="muppets"
          fetch="https://github.com/TheMuppets" />

  <!-- Device -->
  <project path="device/oneplus/giuliac"
           name="android_device_oneplus_giuliac"
           remote="lineage"
           revision="lineage-23.2" />
  
  <project path="device/oneplus/sm8650-common"
           name="android_device_oneplus_sm8650-common"
