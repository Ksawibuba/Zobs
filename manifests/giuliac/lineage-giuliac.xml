  <project path="kernel/oneplus/sm8650-modules"
           name="android_kernel_oneplus_sm8650-modules"
           remote="lineage"
           revision="lineage-23.2" />

  <!-- Vendor -->
  <project path="vendor/oneplus/giuliac"
           name="proprietary_vendor_oneplus_giuliac"
           remote="muppets"
           revision="lineage-23.2" />
  
  <project path="vendor/oneplus/sm8650-common"
